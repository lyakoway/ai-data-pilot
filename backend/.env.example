# Copy to .env and fill keys you have. App boots in mock mode without keys.

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ZAI_API_KEY=

# Local models
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_GPU=0

# Analytics DB (SQLite by default — swap for Postgres if needed)
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/ridego

# Optional: pre-configured PostgreSQL data source for Oleg (registered on startup).
# Test locally: docker compose -f docker-compose.test.yml up -d
# POSTGRES_URL=postgresql://demo:demo@localhost:5433/shop

# small (default, fast HF cold start) | full (denser local demo)
DEMO_SCALE=small
